{
    "name": "uknc",
    "displayName": "УКНЦ",
    "description": "Сборка, запуск и отладка программ для Электроники МС 0511 (УКНЦ)",
    "version": "0.1.0",
    "publisher": "wdigger",
    "license": "MIT",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Debuggers",
        "Programming Languages"
    ],
    "main": "./extension.js",
    "extensionDependencies": [
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools",
        "ms-vscode.vscode-js-profile-flame"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "configuration": {
            "title": "УКНЦ",
            "properties": {
                "uknc.toolchainPath": {
                    "type": "string",
                    "default": "",
                    "description": "Папка тулчейна УКНЦ. Пусто — искать самому: сначала выше папки проекта, потом по PATH, потом там, откуда расширение было собрано."
                },
                "uknc.screen": {
                    "type": "boolean",
                    "default": true,
                    "description": "Показывать экран машины в отдельном окне во время отладки. Окно закрывается вместе с сеансом, а если закрыть его самому — машина останавливается."
                },
                "uknc.profileBy": {
                    "type": "string",
                    "enum": [
                        "line",
                        "function",
                        "address"
                    ],
                    "default": "line",
                    "description": "Кадр в профиле: строка исходника, функция или отдельный адрес."
                },
                "uknc.profileRealTime": {
                    "type": "boolean",
                    "default": false,
                    "description": "Показывать в профиле реальное время, а не такты. Такты пишутся как микросекунды: числа пропорциональны и неверна только подпись, зато их можно сравнивать между прогонами."
                },
                "uknc.profileFrames": {
                    "type": "number",
                    "default": 60000,
                    "description": "Сколько кадров по 1/50 секунды дать программе при профилировании всего прогона, прежде чем счесть её зависшей."
                }
            }
        },
        "debuggers": [
            {
                "type": "uknc",
                "label": "УКНЦ",
                "languages": [
                    "c"
                ],
                "configurationAttributes": {
                    "launch": {
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "ELF для отладки. Пусто — <имя папки>.elf рядом с открытым файлом."
                            },
                            "cwd": {
                                "type": "string",
                                "description": "Рабочая папка. Пусто — папка программы."
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "uknc",
                        "request": "launch",
                        "name": "УКНЦ"
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "УКНЦ: отладить программу",
                        "description": "Поднять машину, загрузить программу и остановиться на первой точке останова",
                        "body": {
                            "type": "uknc",
                            "request": "launch",
                            "name": "УКНЦ"
                        }
                    }
                ]
            }
        ],
        "commands": [
            {
                "command": "uknc.run",
                "title": "Запустить на машине",
                "category": "УКНЦ"
            },
            {
                "command": "uknc.newProject",
                "title": "Создать проект (Makefile)",
                "category": "УКНЦ"
            },
            {
                "command": "uknc.showToolchain",
                "title": "Показать, где найден тулчейн",
                "category": "УКНЦ"
            },
            {
                "command": "uknc.profile",
                "title": "Профилировать прогон",
                "category": "УКНЦ"
            },
            {
                "command": "uknc.profileStart",
                "title": "Включить профилировщик (в сеансе отладки)",
                "category": "УКНЦ"
            },
            {
                "command": "uknc.profileShow",
                "title": "Сохранить и открыть профиль (в сеансе отладки)",
                "category": "УКНЦ"
            },
            {
                "command": "uknc.profileOpen",
                "title": "Открыть профиль (.prof)",
                "category": "УКНЦ"
            }
        ],
        "configurationDefaults": {
            "C_Cpp.default.configurationProvider": "ms-vscode.makefile-tools"
        },
        "menus": {
            "explorer/context": [
                {
                    "command": "uknc.profileOpen",
                    "when": "resourceExtname == .prof",
                    "group": "navigation"
                }
            ]
        }
    }
}
