#!/bin/sh
# uknc-run -- run an RT-11 .sav in the ukncbtl emulator, the way a
# simulator would: print what the program printed, exit with its status.
#
# This is what makes DejaGnu's "sim" board work for this target, so that
# the GCC testsuite's execution tests can actually run: see uknc-sim.exp
# beside this file, and the README section about running them.  Used on
# its own it is a convenient way to run one program:
#
#   uknc-run prog.sav; echo $?
#
# Nothing here is specific to the testsuite.  The program is put on a copy
# of the RT-11 disk image under a name RT-11 will accept, and gdb is asked
# to run it.
#
# gdb, rather than the emulator's own console: the emulator serves gdb's
# remote protocol ("gdbserver" in ukncbtl-debugger), and driving it that
# way is both simpler and better than the keystrokes-and-screen-reading
# this used to do.  A program's output arrives as a byte stream instead of
# being read back off an 80-column screen that longer output would have
# scrolled away, and the emulator says when the program has ended --
# .EXIT is an operating-system call and the server watches for it -- so a
# program that finishes early ends the run early instead of sitting out a
# fixed frame count.
#
# The exit status still comes from the marker uknc_exit.o prints (see
# uknc_exit.c): RT-11 has no way to report one, and .EXIT carries nothing.
# A program that never reaches _exit -- because it hung, or trapped, or
# was too big to load -- prints no marker, and this reports that as a
# failure.
#
# Paths can be overridden through the environment; the defaults are where
# this project keeps things:
#
#   UKNC_EMU     ukncbtldebug, the console build of the emulator
#   UKNC_GDB     pdp11-uknc-rt11-gdb
#   UKNC_DISK    the RT-11 disk image to boot
#   UKNC_ROM     the firmware; the default one boots without being asked
#   UKNC_RT11DSK rt11dsk, which writes a file into that image
#   UKNC_FRAMES  how long to let a program run before calling it hung, in
#                emulated frames (50 = one second)
#   UKNC_PORT    the port to serve gdb on; one is derived per run so that
#                several can go at once

set -e

prog=$1
if [ -z "$prog" ] || [ ! -f "$prog" ]; then
  echo "uknc-run: no such program: $prog" >&2
  exit 99
fi

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)

emu=${UKNC_EMU:-$root/debugger/bin/ukncbtldebug}
gdb=${UKNC_GDB:-pdp11-uknc-rt11-gdb}
disk=${UKNC_DISK:-$root/resources/rt11os.dsk}
rom=${UKNC_ROM:-$root/rom/uknc_rom_autoboot.bin}
rt11dsk=${UKNC_RT11DSK:-rt11dsk}
frames=${UKNC_FRAMES:-3000}

for f in "$emu" "$disk" "$rom"; do
  if [ ! -f "$f" ]; then
    echo "uknc-run: missing $f" >&2
    exit 99
  fi
done

# Every run gets its own directory and its own port, so that several can
# go at once -- "make check" runs tests in parallel.  The emulator wants
# its ROM in the current directory, hence the link.
tmp=$(mktemp -d "${TMPDIR:-/tmp}/uknc-run.XXXXXX")
port=${UKNC_PORT:-$(( 20000 + $$ % 20000 ))}

emupid=
cleanup () {
  if [ -n "$emupid" ]; then
    kill "$emupid" 2>/dev/null || true
  fi
  if [ -z "$UKNC_KEEP" ]; then
    rm -rf "$tmp"
  fi
  return 0
}
if [ -n "$UKNC_KEEP" ]; then
  echo "uknc-run: keeping $tmp" >&2
fi
trap cleanup EXIT INT TERM

ln -s "$rom" "$tmp/uknc_rom.bin"

# RT-11 names are 6.3 and upper case, so whatever the program is called
# here, on the disk it is T.SAV.
cp "$prog" "$tmp/T.SAV"
cp "$disk" "$tmp/t.dsk"
"$rt11dsk" a "$tmp/t.dsk" "$tmp/T.SAV" > /dev/null 2>&1 || {
  echo "uknc-run: could not put the program on the disk" >&2
  exit 99
}

# The emulator does nothing here but attach the disk and wait for gdb:
# booting the machine and starting the program are gdb's "run", which the
# server carries out by resetting, waiting for RT-11 and typing "R T" --
# so nothing has to be timed from out here.  "p" switches it to the
# central processor, which is where programs run; the frame count bounds
# a program that never ends.
{
  echo "disk1 attach $tmp/t.dsk"
  echo "p"
  echo "gdbserver $port $frames"
  echo "q"
} | (cd "$tmp" && "$emu" > emulator.log 2>&1) &
emupid=$!

# Wait for the port, which the server says it is listening on.  This is
# quick -- nothing is booted yet -- but not instant.
waited=0
until grep -q "Listening on localhost:$port" "$tmp/emulator.log" 2>/dev/null; do
  waited=$((waited + 1))
  if [ "$waited" -gt 200 ]; then
    echo "uknc-run: the emulator never started serving gdb" >&2
    exit 99
  fi
  sleep 0.05 2>/dev/null || sleep 1
done

# gdb prints its own messages to stdout and the program's output to
# stderr, so the two come back separately and neither has to be picked
# out of the other.
"$gdb" -batch -nx \
  -ex "set confirm off" \
  -ex "target extended-remote :$port" \
  -ex "set remote exec-file T" \
  -ex "run" \
  > "$tmp/gdb.txt" 2> "$tmp/target.txt" || true

# Except for one thing: gdb warns, more than once, that it has no
# executable to go with the process -- true, since what is being run is a
# .sav and gdb reads ELF.  That is a warning about gdb's own knowledge,
# not about the run, and it is the only thing on that stream which is not
# the program's own output.
# The carriage returns go with them: RT-11's console convention is CR LF
# and newlib writes both, but this is handing back text, not driving a
# terminal.  tr rather than sed, whose \r means a literal r in more than
# one of the seds this might run under.
tr -d '\r' < "$tmp/target.txt" |
  sed -e '/^warning: No executable has been specified/d' \
      -e '/^determining executable automatically/d' > "$tmp/stream.txt"

# And stop at the marker: what the machine prints after a program ends is
# the monitor's prompt, not the program's output.  Everything up to and
# including the marker, since that line is how DejaGnu reads the status
# and it strips it back out itself.
if grep -q '^\*\*\* EXIT code ' "$tmp/stream.txt"; then
  sed -n '1,/^\*\*\* EXIT code /p' "$tmp/stream.txt" > "$tmp/output.txt"
else
  cp "$tmp/stream.txt" "$tmp/output.txt"
fi

cat "$tmp/output.txt"

status=$(sed -n 's/^\*\*\* EXIT code \([0-9][0-9]*\).*/\1/p' "$tmp/output.txt" | tail -1)
if [ -z "$status" ]; then
  # No marker: the program never reached _exit.  Say why if there is
  # anything to say -- a hang, a trap and "too big to load" look alike
  # from here, and between the two streams some of them are told apart.
  reason=$(grep -m1 -h -E "KMON-F|CТOП|signal" \
           "$tmp/stream.txt" "$tmp/gdb.txt" 2>/dev/null || true)
  if [ -n "$reason" ]; then
    echo "uknc-run: $reason" >&2
  fi
  echo "uknc-run: no exit marker, the program did not finish" >&2
  exit 98
fi

exit "$(expr "$status" + 0)"
