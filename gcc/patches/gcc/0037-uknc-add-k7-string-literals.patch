+static bool
+koi7_map_char (cppchar_t wc, uchar *mode, uchar *byte)
+{
+  *mode = '\017';
+  if (wc < 0x80)
+    {
+      *byte = wc;
+      return true;
+    }
 
+  *mode = '\016';
+  switch (wc)
+    {
+    case 0x0410: *byte = 0x61; return true;
+    case 0x0411: *byte = 0x62; return true;
+    case 0x0412: *byte = 0x77; return true;
+    case 0x0413: *byte = 0x67; return true;
+    case 0x0414: *byte = 0x64; return true;
+    case 0x0415: *byte = 0x65; return true;
+    case 0x0401: *byte = 0x65; return true;
+    case 0x0416: *byte = 0x76; return true;
+    case 0x0417: *byte = 0x7a; return true;
+    case 0x0418: *byte = 0x69; return true;
+    case 0x0419: *byte = 0x6a; return true;
+    case 0x041a: *byte = 0x6b; return true;
+    case 0x041b: *byte = 0x6c; return true;
+    case 0x041c: *byte = 0x6d; return true;
+    case 0x041d: *byte = 0x6e; return true;
+    case 0x041e: *byte = 0x6f; return true;
+    case 0x041f: *byte = 0x70; return true;
+    case 0x0420: *byte = 0x72; return true;
+    case 0x0421: *byte = 0x73; return true;
+    case 0x0422: *byte = 0x74; return true;
+    case 0x0423: *byte = 0x75; return true;
+    case 0x0424: *byte = 0x66; return true;
+    case 0x0425: *byte = 0x68; return true;
+    case 0x0426: *byte = 0x63; return true;
+    case 0x0427: *byte = 0x7e; return true;
+    case 0x0428: *byte = 0x7b; return true;
+    case 0x0429: *byte = 0x7d; return true;
+    case 0x042a: *byte = 0x7f; return true;
+    case 0x042b: *byte = 0x79; return true;
+    case 0x042c: *byte = 0x78; return true;
+    case 0x042d: *byte = 0x7c; return true;
+    case 0x042e: *byte = 0x60; return true;
+    case 0x042f: *byte = 0x71; return true;
+    case 0x0430: *byte = 0x41; return true;
+    case 0x0431: *byte = 0x42; return true;
+    case 0x0432: *byte = 0x57; return true;
+    case 0x0433: *byte = 0x47; return true;
+    case 0x0434: *byte = 0x44; return true;
+    case 0x0435: *byte = 0x45; return true;
+    case 0x0451: *byte = 0x45; return true;
+    case 0x0436: *byte = 0x56; return true;
+    case 0x0437: *byte = 0x5a; return true;
+    case 0x0438: *byte = 0x49; return true;
+    case 0x0439: *byte = 0x4a; return true;
+    case 0x043a: *byte = 0x4b; return true;
+    case 0x043b: *byte = 0x4c; return true;
+    case 0x043c: *byte = 0x4d; return true;
+    case 0x043d: *byte = 0x4e; return true;
+    case 0x043e: *byte = 0x4f; return true;
+    case 0x043f: *byte = 0x50; return true;
+    case 0x0440: *byte = 0x52; return true;
+    case 0x0441: *byte = 0x53; return true;
+    case 0x0442: *byte = 0x54; return true;
+    case 0x0443: *byte = 0x55; return true;
+    case 0x0444: *byte = 0x46; return true;
+    case 0x0445: *byte = 0x48; return true;
+    case 0x0446: *byte = 0x43; return true;
+    case 0x0447: *byte = 0x5e; return true;
+    case 0x0448: *byte = 0x5b; return true;
+    case 0x0449: *byte = 0x5d; return true;
+    case 0x044a: *byte = 0x5f; return true;
+    case 0x044b: *byte = 0x59; return true;
+    case 0x044c: *byte = 0x58; return true;
+    case 0x044d: *byte = 0x5c; return true;
+    case 0x044e: *byte = 0x40; return true;
+    case 0x044f: *byte = 0x51; return true;
+    default:
+      *mode = '\017';
+      *byte = '?';
+      return true;
+    }
+}
+
+static bool
+convert_utf8_koi7 (iconv_t cd ATTRIBUTE_UNUSED,
+		   const uchar *from, size_t flen, struct _cpp_strbuf *to)
+{
+  const uchar *p = from;
+  size_t bytesleft = flen;
+
+  while (bytesleft)
+    {
+      cppchar_t wc;
+      int err = one_utf8_to_cppchar (&p, &bytesleft, &wc);
+      uchar mode, byte;
+
+      if (err)
+	{
+	  errno = err;
+	  return false;
+	}
+
+      if (!koi7_map_char (wc, &mode, &byte))
+	return false;
+
+      if (to->len + 2 > to->asize)
+	{
+	  to->asize = MAX (to->asize + OUTBUF_BLOCK_SIZE, to->len + 2);
+	  to->text = XRESIZEVEC (uchar, to->text, to->asize);
+	}
+      to->text[to->len++] = mode;
+      to->text[to->len++] = byte;
+    }
+  return true;
+}
