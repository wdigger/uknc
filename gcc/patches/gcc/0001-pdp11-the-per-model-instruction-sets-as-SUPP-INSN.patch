+      opts->x_target_flags |= (MASK_FPU | MASK_AC0 | MASK_SPLIT);
+      opts->x_pdp11_model = OPTION_MASK_M11_45;
       return true;
 
     case OPT_mfpu:
-      opts->x_target_flags &= ~MASK_40;
-      opts->x_target_flags |= MASK_45;
+      opts->x_pdp11_model &= ~OPTION_MASK_M11_40;
+      opts->x_pdp11_model |= OPTION_MASK_M11_45;
       return true;
 
     case OPT_msoft_float:
@@ -56,8 +63,8 @@ pdp11_handle_option (struct gcc_options *opts,
       return true;
 
     case OPT_msplit:
-      opts->x_target_flags &= ~MASK_40;
-      opts->x_target_flags |= MASK_45;
+      opts->x_pdp11_model &= ~OPTION_MASK_M11_40;
+      opts->x_pdp11_model |= OPTION_MASK_M11_45;
       return true;
 
     case OPT_munix_asm:
@@ -86,7 +93,10 @@ pdp11_option_init_struct (struct gcc_options *opts)
 
