From c81bf4ee927dcdcfc6758ead63fe3f758af15fd1 Mon Sep 17 00:00:00 2001
From: Yury Klushin <digger@live.ru>
Date: Sun, 13 Sep 2026 10:45:10 +0300
Subject: [PATCH] fp-bit: the PDP-11 float formats are DEC's, not IEEE's

Everything fp-bit computes, it computes on an unpacked sign, exponent and
fraction; the format itself lives in a block of numbers in fp-bit.h and in
pack and unpack.  So teaching it the DEC formats is a matter of different
numbers rather than different logic, and the arithmetic then comes out
right on its own.

Single precision differs from IEEE single only in the bias, which is over
a fraction taken as lying in [0.5, 1) rather than [1, 2).  Double
precision differs more: the exponent is 8 bits wide, as in single
precision, and the fraction takes the other 55, which also moves the
offset between the two mantissas that the float to double conversion needs
-- and that conversion is compiled once in each of the two
configurations, so the offset has to be set in both.  The words of a
double are stored most significant first here, which is how this machine
stores a 64-bit integer too, so the two halves must not be swapped the way
a mismatch of word orders would otherwise call for.

Neither format has an infinity, a NaN or a denormal, which leaves the two
extreme exponent values meaning nothing in particular.  NO_DENORMALS
already exists as a knob; NO_SPECIAL_EXPONENTS is new and does the other
half, in two places: unpack no longer reads the largest exponent as an
infinity or a NaN, and pack, having no infinity to overflow into, stops at
the largest finite magnitude instead.  Underflow goes to zero.

Before this, double precision on this target was not merely scaled but
meaningless: 3.0 + 2.0 returned a negative number and 3.0 * 2.0 returned
zero.  Single precision multiply and divide were out by a factor of four.
Both are now right, which also means that -mfis is purely a speed option
and no longer the only way to get a correct single precision multiply.

Verified by running code on a UKNC under RT-11, comparing against the
compiler's own folded constants: arithmetic, comparisons and conversions
in both precisions, float to double and back, 64-bit integers both ways,
the top of the exponent range, overflow and underflow.  The whole
gcc.c-torture/compile suite comes out with the same 10245 passes and 69
failures as before, the same failures file for file, and gcc.target/pdp11
is 112 passes and no failures.

Not yet right, and nothing to do with this change: newlib's math
functions, which are fdlibm and read IEEE exponent and mantissa fields
straight out of the bits.
---
 libgcc/fp-bit.c | 13 +++++++++++++
 libgcc/fp-bit.h | 52 +++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 65 insertions(+)

diff --git a/libgcc/fp-bit.c b/libgcc/fp-bit.c
index e0c447ad70dd8..6a4720f910a9a 100644
--- a/libgcc/fp-bit.c
+++ b/libgcc/fp-bit.c
@@ -283,11 +283,22 @@ pack_d (const fp_number_type *src)
 	  fraction >>= NGARDS;
 #endif /* NO_DENORMALS */
 	}
+#ifdef NO_SPECIAL_EXPONENTS
+      /* The largest exponent is an ordinary one in this format, so the
+	 range reaches one octave further up, and there is no infinity to
+	 overflow into: stop at the largest finite magnitude instead.  */
+      else if (__builtin_expect (src->normal_exp > EXPMAX - EXPBIAS, 0))
+	{
+	  exp = EXPMAX;
+	  fraction = (((fractype) 1 << FRACBITS) - 1);
+	}
+#else
       else if (__builtin_expect (src->normal_exp > EXPBIAS, 0))
 	{
 	  exp = EXPMAX;
 	  fraction = 0;
 	}
+#endif
       else
 	{
 	  exp = src->normal_exp + EXPBIAS;
@@ -525,6 +536,7 @@ unpack_d (FLO_union_type * src, fp_number_type * dst)
 	  dst->fraction.ll = fraction;
 	}
     }
+#ifndef NO_SPECIAL_EXPONENTS
   else if (__builtin_expect (exp == EXPMAX, 0))
     {
       /* Huge exponent*/
@@ -554,6 +566,7 @@ unpack_d (FLO_union_type * src, fp_number_type * dst)
 	  dst->fraction.ll = fraction << NGARDS;
 	}
     }
+#endif /* !NO_SPECIAL_EXPONENTS */
   else
     {
       /* Nothing strange about this number */
diff --git a/libgcc/fp-bit.h b/libgcc/fp-bit.h
index 4b191ecd4f4ea..71815d0471f77 100644
--- a/libgcc/fp-bit.h
+++ b/libgcc/fp-bit.h
@@ -302,6 +302,58 @@ typedef unsigned int UTItype __attribute__ ((mode (TI)));
 # define D_T_BITOFF (__LDBL_MANT_DIG__-1+10-(52+8))
 #endif
 
+#ifdef __pdp11__
+/* The PDP-11 float formats are DEC's, not IEEE's: see pdp11_f_format and
+   pdp11_d_format in gcc/config/pdp11/pdp11.cc.  The shape is the same --
+   a sign, then an exponent, then a fraction with a hidden leading one --
+   so the code here needs different numbers rather than different logic,
+   plus the knowledge that neither format has an infinity, a NaN or a
+   denormal, which leaves the two extreme exponent values meaning nothing
+   in particular.  Without these overrides the whole file computes in IEEE
+   and the answers come out scaled by a power of two in single precision
+   and meaningless in double.
+
+   Single precision differs from IEEE single only in the bias, which is
+   over a fraction taken as lying in [0.5, 1) rather than [1, 2).  Double
+   precision differs more: the exponent is 8 bits wide, as in single
+   precision, and the fraction takes the other 55.
+
+   The words of a double are stored most significant first, which is how
+   this machine stores a 64-bit integer too, so the two halves must not be
+   swapped the way a mismatch of word orders would otherwise call for.  */
+
+#undef FLOAT_WORD_ORDER_MISMATCH
+
+#undef EXPBIAS
+#define EXPBIAS 129
+
+/* Both halves of the float to double conversion need this, and that is
+   compiled once in each of the two configurations, so it cannot sit in
+   the double-only part below.  */
+#undef F_D_BITOFF
+#define F_D_BITOFF (55+7-(23+7))
+
+#if !defined (FLOAT) && !defined (TFLOAT)
+#undef NGARDS
+#define NGARDS    7L
+#undef GARDROUND
+#define GARDROUND 0x3f
+#undef GARDMASK
+#define GARDMASK  0x7f
+#undef GARDMSB
+#define GARDMSB   0x40
+#undef EXPBITS
+#define EXPBITS 8
+#undef FRACBITS
+#define FRACBITS 55
+#undef EXPMAX
+#define EXPMAX (0xff)
+#endif /* double */
+
+#define NO_DENORMALS 1
+#define NO_SPECIAL_EXPONENTS 1
+#endif /* __pdp11__ */
+
 
 #define NORMAL_EXPMIN (-(EXPBIAS)+1)
 #define IMPLICIT_1 ((fractype)1<<(FRACBITS+NGARDS))
