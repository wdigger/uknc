index eeb28e9e55d8b..612c778f64372 100644
--- a/gcc/config/pdp11/pdp11.opt
+++ b/gcc/config/pdp11/pdp11.opt
@@ -75,6 +75,10 @@ mfpu
 Target RejectNegative Mask(FPU)
 Use hardware floating point.
 
+mfis
+Target Mask(FIS)
+Use the FIS floating point instructions for single precision arithmetic.
+
 mint16
 Target InverseMask(INT32, INT16)
 Use 16 bit int.
diff --git a/gcc/doc/invoke.texi b/gcc/doc/invoke.texi
index 64a3131c19068..3eb925ab29bef 100644
--- a/gcc/doc/invoke.texi
+++ b/gcc/doc/invoke.texi
@@ -1248,7 +1248,8 @@ Objective-C and Objective-C++ Dialects}.
 -mcmodel=@var{code-model}}
 
 @emph{PDP-11 Options} (@ref{PDP-11 Options})
-@gccoptlist{-mfpu  -msoft-float  -mac0  -mno-ac0  -m40  -m45  -m10
+@gccoptlist{-mfpu  -msoft-float  -mfis  -mno-fis  -mac0  -mno-ac0
+-m40  -m45  -m10
 -mint32  -mno-int16  -mint16  -mno-int32
 -msplit  -munix-asm  -mdec-asm  -mgnu-asm  -mlra}
 
@@ -30863,13 +30864,30 @@ These options are defined for the PDP-11:
 @table @gcctabopt
 @opindex mfpu
 @item -mfpu
-Use hardware FPP floating point.  This is the default.  (FIS floating
-point on the PDP-11/40 is not supported.)  Implies -m45.
+Use hardware FPP floating point.  This is the default.  Implies -m45.
 
 @opindex msoft-float
 @item -msoft-float
 Do not use hardware floating point.
 
+@opindex mfis
+@opindex mno-fis
+@item -mfis
+Use the FIS floating point instructions @code{fadd}, @code{fsub},
+@code{fmul} and @code{fdiv} for @code{float} arithmetic, instead of
+calling the library routines.  FIS is the small stack-based floating
+point option of the PDP-11 line, the KE11-F on the PDP-11/35 and /40 and
+the KEV11 on the PDP-11/03; it covers the four basic operations on single
+precision values only, so conversions, comparisons and anything in
+@code{double} still go to the library.  FIS and FPP are alternatives, so
+this option cannot be combined with @option{-mfpu}.  It is off by
+default, and @option{-mno-fis} turns it back off, because availability is
+a property of the machine rather than of the processor: some machines
+emulate the four instruction codes in a monitor trap handler instead of
+executing them, and where nothing handles them the program dies.  Note
+also that FIS traps on overflow, underflow and division by zero, where
+the library routines return a value.
+
 @opindex mac0
 @item -mac0
 Return floating-point results in ac0 (fr0 in Unix assembler syntax).
diff --git a/gcc/testsuite/gcc.target/pdp11/fis-1.c b/gcc/testsuite/gcc.target/pdp11/fis-1.c
new file mode 100644
index 0000000000000..5dba2be507833
--- /dev/null
+++ b/gcc/testsuite/gcc.target/pdp11/fis-1.c
@@ -0,0 +1,46 @@
+/* { dg-do compile { target pdp11-*-* } } */
+/* { dg-options "-O2 -fomit-frame-pointer -mfis" } */
+
+/* -mfis turns the four single precision operations into FIS
+   instructions instead of calls to the library.  FIS addresses its two
+   operands through a general register, the right one at (R) and the
+   left one at (R)+4, so each operation lays them out in a stack
+   temporary first.  */
+
+float
+add (float a, float b)
+{
+  return a + b;
+}
+
+float
+sub (float a, float b)
+{
+  return a - b;
+}
+
+float
+mul (float a, float b)
+{
+  return a * b;
+}
+
+float
+divide (float a, float b)
+{
+  return a / b;
+}
+
+/* { dg-final { scan-assembler "fadd\t" } } */
+/* { dg-final { scan-assembler "fsub\t" } } */
+/* { dg-final { scan-assembler "fmul\t" } } */
+/* { dg-final { scan-assembler "fdiv\t" } } */
+/* Eight bytes of scratch, and the pointer loaded from the stack
+   pointer, in each of the four.  */
+/* { dg-final { scan-assembler-times "add\t.-010,sp" 4 } } */
+/* { dg-final { scan-assembler-times "mov\tsp,r" 4 } } */
+/* No library call is left for any of them.  */
+/* { dg-final { scan-assembler-not "___addsf3" } } */
+/* { dg-final { scan-assembler-not "___subsf3" } } */
+/* { dg-final { scan-assembler-not "___mulsf3" } } */
+/* { dg-final { scan-assembler-not "___divsf3" } } */
diff --git a/gcc/testsuite/gcc.target/pdp11/fis-2.c b/gcc/testsuite/gcc.target/pdp11/fis-2.c
new file mode 100644
index 0000000000000..b97f0f1cd0c81
--- /dev/null
+++ b/gcc/testsuite/gcc.target/pdp11/fis-2.c
@@ -0,0 +1,17 @@
+/* { dg-do compile { target pdp11-*-* } } */
+/* { dg-options "-O2 -fomit-frame-pointer -mfis -mno-fis" } */
+
+/* FIS is off unless asked for, and -mno-fis turns it back off again,
+   because whether the four instruction codes do anything is a property
+   of the machine and not of the processor: some machines emulate them in
+   a monitor trap handler, and elsewhere nothing handles them at all.  So
+   this has to come out as the ordinary library call.  */
+
+float
+mul (float a, float b)
+{
+  return a * b;
+}
+
+/* { dg-final { scan-assembler "jsr\tpc,___mulsf3" } } */
+/* { dg-final { scan-assembler-not "fmul" } } */
diff --git a/gcc/testsuite/gcc.target/pdp11/fis-3.c b/gcc/testsuite/gcc.target/pdp11/fis-3.c
new file mode 100644
index 0000000000000..a1111284bdbc1
--- /dev/null
+++ b/gcc/testsuite/gcc.target/pdp11/fis-3.c
@@ -0,0 +1,25 @@
+/* { dg-do compile { target pdp11-*-* } } */
+/* { dg-options "-O2 -fomit-frame-pointer -mfis" } */
+
+/* A constant operand is stored into the FIS scratch area as two words,
+   the sign and exponent word first because that is the lower address in
+   the PDP-11 single precision format.  1.5 is 040300 0, and 3.0 is
+   040500 0; getting this backwards would be the easy mistake, and the
+   FIS result would then be meaningless.  */
+
+float
+addc (float a)
+{
+  return a + 1.5f;
+}
+
+float
+mulc (float a)
+{
+  return a * 3.0f;
+}
+
+/* { dg-final { scan-assembler "mov\t.040300,\\(sp\\)\n\tclr\t02\\(sp\\)" } } */
+/* { dg-final { scan-assembler "mov\t.040500,\\(sp\\)\n\tclr\t02\\(sp\\)" } } */
+/* { dg-final { scan-assembler "fadd\t" } } */
+/* { dg-final { scan-assembler "fmul\t" } } */
diff --git a/gcc/testsuite/gcc.target/pdp11/fis-4.c b/gcc/testsuite/gcc.target/pdp11/fis-4.c
new file mode 100644
index 0000000000000..8737447497459
--- /dev/null
+++ b/gcc/testsuite/gcc.target/pdp11/fis-4.c
@@ -0,0 +1,14 @@
+/* { dg-do compile { target pdp11-*-* } } */
+/* { dg-options "-O2 -mfis -mfpu" } */
+/* { dg-error "mutually exclusive" "" { target pdp11-*-* } 0 } */
+
+/* FIS and FPP are the two alternative floating point options of the
+   PDP-11 line, never both on one machine, and they do not even agree on
+   where a float lives.  Asking for both is an error rather than a silent
+   choice of one of them.  */
+
+float
+mul (float a, float b)
+{
+  return a * b;
+}
