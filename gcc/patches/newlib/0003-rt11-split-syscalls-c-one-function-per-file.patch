diff --git a/newlib/libc/sys/rt11/write.c b/newlib/libc/sys/rt11/write.c
new file mode 100644
index 000000000..cb495b426
--- /dev/null
+++ b/newlib/libc/sys/rt11/write.c
@@ -0,0 +1,98 @@
+/* write.c -- _write for RT-11 (pdp11-uknc-rt11) */
+
+#include <fcntl.h>
+#include <errno.h>
+#include "rt11fs.h"
+
+/* .TTYOUT -- EMT 341.  Character in R0; BCS retries while the console
+   is still busy transmitting the previous one.  The EMT reads/writes R0
+   specifically, not just "some register", so it's pinned by name (same
+   trick sbrk.c uses for the stack pointer) rather than left to a
+   generic "r" constraint, which wouldn't guarantee R0.  */
+static void
+rt11_ttyout (char c)
+{
+  register unsigned short r0 asm ("r0") = (unsigned char) c;
+  asm volatile (
+    "1: emt 0341\n\t"
+    "bcs 1b"
+    : "+r" (r0)
+    :
+    : "cc");
+}
+
+int
+_write (int file, const void *ptr, size_t len)
+{
+  const unsigned char *p = (const unsigned char *) ptr;
+  size_t i;
+  struct rt11_file *f;
+
+  if (file == 1 || file == 2)
+    {
+      for (i = 0; i < len; i++)
+	rt11_ttyout ((char) p[i]);
+      return (int) len;
+    }
+
+  f = rt11_fd_to_slot (file);
+  if (f == NULL || !f->writable)
+    {
+      errno = EBADF;
+      return -1;
+    }
+
+  /* O_APPEND: every write() jumps to append_pos first -- the exact
+     highest byte position reached by a write() in THIS open session,
+     ignoring any lseek() done since.  append_pos starts out block-
+     rounded (from size_blocks at open time, the best RT-11 itself can
+     report for a file that was already closed once -- .CLOSE doesn't
+     preserve byte-exact length), but every write() call while this fd
+     stays open keeps it byte-exact from then on -- see the update at
+     the end of this function.  Consequence, documented in rt11fs.h:
+     appending to a file that was closed and reopened can only continue
+     from a whole-block boundary, but appending across multiple write()
+     calls on the SAME still-open fd lands exactly where the previous
+     write() left off, regardless of a stray lseek() in between.  */
+  if (f->append)
+    f->pos = f->append_pos;
+
+  /* blk/off_in_blk are derived from f->pos ONCE here, then advanced by
+     plain increment (wrapping at RT11_BLOCK_BYTES) instead of re-deriving
+     them from f->pos via division/modulo on every byte -- off_t is a
+     32-bit type on this 16-bit target, so a division per byte is both
+     needlessly expensive and, per this project's established practice of
+     not trusting this rare backend's codegen for anything unusual,
+     avoided outright.  f->pos itself is only updated once, at the end.  */
+  {
+    unsigned short blk = (unsigned short) (f->pos / RT11_BLOCK_BYTES);
+    unsigned short off_in_blk = (unsigned short) (f->pos % RT11_BLOCK_BYTES);
+
+    for (i = 0; i < len; i++)
+      {
+	if (blk >= f->alloc_blocks)
+	  {
+	    errno = ENOSPC;
+	    break;
+	  }
+	if (!rt11_ensure_block (f, blk))
+	  {
+	    errno = EIO;
+	    break;
+	  }
+	((unsigned char *) f->buf)[off_in_blk] = p[i];
+	f->dirty = 1;
+	off_in_blk++;
+	if (off_in_blk == RT11_BLOCK_BYTES)
+	  {
+	    off_in_blk = 0;
+	    blk++;
+	  }
+      }
+  }
+
+  f->pos += (off_t) i;
+  if (f->pos > f->append_pos)
+    f->append_pos = f->pos;
+  return i > 0 ? (int) i : (len > 0 ? -1 : 0);
+}
