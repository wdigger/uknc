diff --git a/newlib/libc/sys/rt11/close.c b/newlib/libc/sys/rt11/close.c
new file mode 100644
index 000000000..11ba403a7
--- /dev/null
+++ b/newlib/libc/sys/rt11/close.c
@@ -0,0 +1,40 @@
+/* close.c -- _close for RT-11 (pdp11-uknc-rt11) */
+
+#include <errno.h>
+#include "rt11fs.h"
+
+int
+_close (int file)
+{
+  struct rt11_file *f;
+  int ok = 1;
+
+  if (file == 0 || file == 1 || file == 2)
+    return 0;
+
+  f = rt11_fd_to_slot (file);
+  if (f == NULL)
+    {
+      errno = EBADF;
+      return -1;
+    }
+
+  if (f->have_block && f->dirty)
+    {
+      ok = rt11_writw_raw (f, f->cur_block, RT11_BLOCK_WORDS);
+      if (ok && f->cur_block >= f->size_blocks)
+	f->size_blocks = (unsigned short) (f->cur_block + 1);
+    }
+
+  if (!rt11_close_emt (f->chan))
+    ok = 0;
+
+  f->in_use = 0;
+
+  if (!ok)
+    {
+      errno = EIO;
+      return -1;
+    }
+  return 0;
+}
diff --git a/newlib/libc/sys/rt11/fstat.c b/newlib/libc/sys/rt11/fstat.c
new file mode 100644
index 000000000..2071f5c23
--- /dev/null
+++ b/newlib/libc/sys/rt11/fstat.c
@@ -0,0 +1,31 @@
+/* fstat.c -- _fstat for RT-11 (pdp11-uknc-rt11) */
+
+#include <sys/stat.h>
+#include <errno.h>
+#include "rt11fs.h"
+
+int
+_fstat (int file, struct stat *st)
+{
+  struct rt11_file *f;
+
+  if (file == 0 || file == 1 || file == 2)
+    {
+      st->st_mode = S_IFCHR;
+      return 0;
+    }
+
+  f = rt11_fd_to_slot (file);
+  if (f == NULL)
+    {
+      errno = EBADF;
+      return -1;
+    }
+
+  st->st_mode = S_IFREG;
+  /* append_pos: this session's byte-exact high-water mark (see rt11fs.h
+     and lseek.c's matching SEEK_END case) -- block-rounded only for a
+     file this session has never written to. */
+  st->st_size = f->append_pos;
+  return 0;
+}
