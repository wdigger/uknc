#!/usr/bin/env sh
# pdp11-uknc-rt11-ld-ppu -- linker for PPU-side .ppu programs.
#
# A thin wrapper around the real pdp11-uknc-rt11-ld: passes every
# argument through unchanged, with everything a PPU program's own
# link needs already applied ahead of them --
#
#   -r -m pdp11rt11rel -T $SYSROOT/lib/ppu.ld -u start
#       -L$SYSROOT/lib -lppu
#
# (see ppu_server.h/ppu.ld/ppus_start.c for what each of those is
# actually for and why a PPU program's build needs it) -- so a
# Makefile just needs:
#
#   pdp11-uknc-rt11-ld-ppu -o myprogram.ppu myprogram.o
#
# instead of spelling out every flag by hand, the same way this
# project's real pdp11-uknc-rt11-ld is normally invoked for anything
# CPU-side.
#
# With --elf first, the same objects are linked as an ELF executable
# instead of an RT-11 object module:
#
#   pdp11-uknc-rt11-ld-ppu --elf -o myprogram.ppu.elf myprogram.o
#
# Same code, same layout, but with the symbols and DWARF a .PPU has
# nowhere to keep -- this is what gdb reads to debug PPU code (see
# ppu.gdb, and ppuc_code_base in ppu_client.h).  It is linked at
# address 0, since where the module ends up is only known once it is
# loaded; ppu.gdb's ppu-symbols command supplies that address as the
# offset.  Nothing runs this file, so -r is dropped and the program's
# own entry point named instead, to keep --gc-sections (if asked for)
# from starting at nothing.
#
# Installed alongside the real pdp11-uknc-rt11-ld (see
# ../../gcc/build_gcc_uknc.sh) -- its own directory is how this script
# finds both that binary and the sysroot (a fixed sibling of it, per
# this project's own build layout), so it keeps working wherever the
# toolchain itself gets installed.
#
# A toolchain built into bin-<variant> keeps its sysroot in
# xgcc-<variant> to match, so carry the suffix from the directory this
# copy was run out of.  That is how the ELF toolchain was built beside
# the a.out one while the two existed side by side, and without it a
# second toolchain's ld quietly links against the first one's libppu.a.

set -e

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case $(basename -- "${script_dir}") in
    bin-*) variant="-${script_dir##*/bin-}" ;;
    *)     variant="" ;;
esac
sysroot="${script_dir}/../xgcc${variant}/pdp11-uknc-rt11"

# The two differ only in the format and in -r; the script, the entry
# point and the libraries are a PPU program's own and the same either
# way.
if [ "$1" = "--elf" ]; then
    shift
    set -- -m pdp11rt11 -e start "$@"
else
    set -- -r -m pdp11rt11rel "$@"
fi

exec "${script_dir}/pdp11-uknc-rt11-ld" \
    -T "${sysroot}/lib/ppu.ld" -u start \
    "$@" \
    -L"${sysroot}/lib" -lppu
